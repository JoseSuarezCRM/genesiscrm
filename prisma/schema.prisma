// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  STAFF
}

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

enum BroadcastRecipientType {
  PATIENT
  PROVIDER
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGIN_LOCKED
  LOGOUT
  REFERRAL_VIEW
  REFERRAL_CREATE
  REFERRAL_UPDATE
  REFERRAL_DELETE
  DOCUMENT_UPLOAD
  DOCUMENT_VIEW
  DOCUMENT_DELETE
  EXPORT_CSV
  USER_CREATE
  USER_UPDATE
  USER_DELETE
  PASSWORD_RESET
  OUTREACH_SENT
}

enum OutreachChannel {
  SMS
  EMAIL
}

enum OutreachTrigger {
  MANUAL
  STATUS_SCHEDULED
  STATUS_COMPLETED
  REMINDER_24HR
}

enum OutreachStatus {
  SENT
  FAILED
}

enum CallOutcome {
  NO_ANSWER
  VOICEMAIL
  ANSWERED
}

enum AutomationTrigger {
  REFERRAL_CREATED
  REFERRAL_STATUS_CHANGED
  PROVIDER_REFERRAL_COUNT
  PRACTICE_REFERRAL_COUNT
  REFERRAL_NO_ACTIVITY
  APPOINTMENT_UPCOMING
  CALL_ATTEMPTS_REACHED
  REFERRAL_ASSIGNED
  APPOINTMENT_OVERDUE
  REFERRAL_STALE
  TAG_ADDED
  DOCUMENT_UPLOADED
  AUTH_STATUS_CHANGED
  LOCATION_REFERRAL_COUNT
  EMBED_REFERRAL_RECEIVED
  PIPELINE_CHANGED
  SURGERY_STATUS_CHANGED
  SURGERY_CALL_ATTEMPTS_REACHED
}

enum AutomationAction {
  CREATE_TASK
  SEND_NOTIFICATION
  SEND_EMAIL
  SEND_SMS
  SEND_MEETING_INVITE
  UPDATE_REFERRAL_STATUS
  ASSIGN_REFERRAL
  ADD_TAG
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum ReferralStatus {
  NEW
  READY_FOR_CALL
  CONTACTED
  SCHEDULED
  COMPLETED
  NO_SHOW
  LOST
}

enum CustomPropertyType {
  TEXT
  LONG_TEXT
  NUMBER
  EMAIL
  PHONE
  DATE
  CHECKBOX
  DROPDOWN
  MULTI_SELECT
  URL
}

enum CustomPropertyEntityType {
  REFERRAL
  PROVIDER
  PRACTICE
  LOCATION
}

model CustomProperty {
  id          String                     @id @default(cuid())
  name        String                     // e.g., "Surgery Type", "Insurance Plan"
  type        CustomPropertyType
  entityType  CustomPropertyEntityType
  required    Boolean                    @default(false)
  description String?
  options     String[]                   @default([])  // for DROPDOWN and MULTI_SELECT
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  @@unique([name, entityType])
}

// ── Custom objects (HubSpot-style) ───────────────────────────────────────────
// An admin-defined object type. Its property schema lives in `properties` (JSON)
// so no per-object table is needed. Records are CustomObjectRecord rows.
model CustomObjectDef {
  id          String   @id @default(cuid())
  key         String   @unique              // url slug, e.g. "visits"
  singular    String                        // "Visit"
  plural      String                        // "Visits"
  icon        String?                       // lucide icon name
  ownerLabel  String                        // "Visit Owner"
  // [{ id, name, type, options?, required?, primary? }] — the record schema.
  properties  Json     @default("[]")
  // [{ id, title, column: "LEFT"|"MIDDLE", propertyIds: string[] }] — detail card layout.
  cards       Json     @default("[]")
  order       Int      @default(0)          // nav ordering
  createdById String?
  createdBy   User?    @relation("CustomObjectDefCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  records     CustomObjectRecord[]
}

model CustomObjectRecord {
  id             String          @id @default(cuid())
  recordNumber   Int?            // per-object sequential "Record ID" (unique id)
  objectDefId    String
  objectDef      CustomObjectDef @relation(fields: [objectDefId], references: [id], onDelete: Cascade)
  values         Json            @default("{}") // { propertyId: value }
  // Default properties every record gets:
  ownerId        String?         // Record Owner (defaults to creator)
  owner          User?           @relation("CustomObjectRecordOwner", fields: [ownerId], references: [id])
  createdById    String?
  createdBy      User?           @relation("CustomObjectRecordCreatedBy", fields: [createdById], references: [id])
  updatedById    String?         // resolved to a name at read time
  lastViewedById String?
  lastViewedAt   DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([objectDefId, recordNumber])
  @@index([objectDefId])
}

// ── Data model: associations between objects (custom + built-in) ─────────────
// A defined relationship between two object types. `typeA`/`typeB` are registry
// keys: "CO:<key>" for custom objects, or a built-in like "REFERRAL"/"PROVIDER".
model ObjectAssociationDef {
  id        String   @id @default(cuid())
  typeA     String
  typeB     String
  label     String?
  createdAt DateTime @default(now())

  @@unique([typeA, typeB])
}

// A link between two specific records (heterogeneous — no FKs).
model ObjectAssociation {
  id        String   @id @default(cuid())
  fromType  String
  fromId    String
  toType    String
  toId      String
  createdAt DateTime @default(now())

  @@unique([fromType, fromId, toType, toId])
  @@index([fromType, fromId])
  @@index([toType, toId])
}

model CustomObjectView {
  id            String   @id @default(cuid())
  objectKey     String                    // which custom object this view belongs to
  name          String
  userId        String
  user          User     @relation("CustomObjectViewCreatedBy", fields: [userId], references: [id], onDelete: Cascade)
  config        Json                       // { filter, columns }
  visibility    String   @default("PRIVATE") // PRIVATE | EVERYONE | TEAM | CUSTOM
  teamId        String?
  sharedUserIds String[] @default([])
  createdAt     DateTime @default(now())

  @@index([objectKey])
  @@index([userId])
}

model PropertyDisplayConfig {
  id               String                     @id @default(cuid())
  customPropertyId String
  entityType       CustomPropertyEntityType
  visible          Boolean                    @default(true)
  order            Int                        @default(0)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@unique([customPropertyId, entityType])
}

model CardLayout {
  id               String                     @id @default(cuid())
  entityType       CustomPropertyEntityType
  cardName         String
  title            String
  fields           String[]                   @default([])
  section          String                     @default("RIGHT") // LEFT (properties sidebar) or RIGHT (associated objects)
  visible          Boolean                    @default(true)
  order            Int                        @default(0)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@unique([entityType, cardName])
}

model User {
  id                    String         @id @default(cuid())
  email                 String         @unique
  name                  String?
  password              String
  role                  Role           @default(STAFF)
  permissions           String[]       @default([])
  createdAt             DateTime       @default(now())
  // HIPAA security fields
  failedLoginAttempts   Int            @default(0)
  lockedUntil           DateTime?
  lastLoginAt           DateTime?
  isActive              Boolean        @default(true)
  // Invite flow: a pending user is created with isActive=false + a token; they
  // set their own password via the accept-invite link, which activates them.
  inviteToken           String?        @unique
  inviteTokenExpires    DateTime?
  // Notification preferences
  notifyOnEmbedReferral Boolean        @default(false)
  // When on, the user can send app emails from their own @genesisortho.com
  // mailbox (via the org's Microsoft 365 connection — no separate credentials).
  emailSendingEnabled   Boolean        @default(false)
  referralsCreated      Referral[]     @relation("ReferralCreatedBy")
  referralsAssigned     Referral[]     @relation("ReferralAssignedTo")
  providerNotes         ProviderNote[]
  auditLogs             AuditLog[]
  outreachMessages      OutreachMessage[]
  emailBroadcasts       EmailBroadcast[]
  callAttempts          CallAttempt[]
  tasksCreated          Task[]         @relation("TaskCreatedBy")
  tasksAssigned         Task[]         @relation("TaskAssignedTo")
  notifications         Notification[]
  automations           Automation[]
  activities            Activity[]
  completedAppointments CompletedAppointment[]
  smsMessages           SmsMessage[]
  teamMemberships       TeamMember[]
  directEmails          DirectEmail[]
  activityViews         ActivityView[]
  providerViews         ProviderView[]
  surgeryViews          SurgeryView[]
  savedReports          SavedReport[]        @relation("SavedReportCreatedBy")
  dashboards            Dashboard[]          @relation("DashboardCreatedBy")
  surgeryCases          SurgeryCase[]        @relation("SurgeryCaseCreatedBy")
  surgeryCallAttempts   SurgeryCallAttempt[] @relation("SurgeryCallAttemptCalledBy")
  surgeryDocuments      SurgeryDocument[]    @relation("SurgeryDocumentUploadedBy")
  customObjectDefs      CustomObjectDef[]    @relation("CustomObjectDefCreatedBy")
  customRecordsCreated  CustomObjectRecord[] @relation("CustomObjectRecordCreatedBy")
  customRecordsOwned    CustomObjectRecord[] @relation("CustomObjectRecordOwner")
  customObjectViews     CustomObjectView[]   @relation("CustomObjectViewCreatedBy")
}

model Team {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  permissions String[]     @default([])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     TeamMember[]
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  userId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model ReferringPractice {
  id                 String             @id @default(cuid())
  name               String
  phone              String?
  fax                String?
  address            String?
  customProperties   Json               @default("{}") // custom property values
  createdAt          DateTime           @default(now())
  locations          PracticeLocation[]
  doctors            ReferringDoctor[]
  referrals          Referral[]
  activities         Activity[]
}

// A specific office/campus of a practice
model PracticeLocation {
  id               String            @id @default(cuid())
  name             String            // e.g. "Main Office", "North Campus"
  phone            String?
  fax              String?
  address          String?
  customProperties Json              @default("{}") // custom property values
  practiceId String
  practice   ReferringPractice @relation(fields: [practiceId], references: [id])
  doctors    DoctorLocation[]
  referrals  Referral[]
  activities Activity[]
  createdAt  DateTime          @default(now())
}

enum ContactType {
  PROVIDER
  STAFF
}

// A provider — belongs to one practice, can work at multiple locations
model ReferringDoctor {
  id                 String             @id @default(cuid())
  name               String
  title              String?            // MD, DO, NP, PA-C, DPM, etc.
  npi                String?            // National Provider Identifier (10 digits)
  specialty          String?
  phone              String?
  officePhone        String?            // office / practice direct line
  email              String?
  contactType        ContactType        @default(PROVIDER)
  customProperties   Json               @default("{}") // custom property values
  practiceId         String
  practice           ReferringPractice  @relation(fields: [practiceId], references: [id])
  locations          DoctorLocation[]
  referrals          Referral[]
  providerNotes      ProviderNote[]
  activities         ActivityProvider[]
  createdAt          DateTime           @default(now())
}

// Join table: doctor <-> location (many-to-many)
model DoctorLocation {
  doctorId   String
  locationId String
  doctor     ReferringDoctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  location   PracticeLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([doctorId, locationId])
}

model Pipeline {
  id        String     @id @default(cuid())
  name      String     @unique
  color     String     @default("#3b82f6")
  order     Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  referrals Referral[]
}

model Referral {
  id                  String             @id @default(cuid())
  // Patient info
  patientFirstName    String
  patientLastName     String
  patientMrn          String?            // Medical Record Number (from referring source/fax)
  genesisMrn          String?            // Internal Genesis Ortho MRN
  patientPhone        String?
  patientEmail        String?
  patientDob          DateTime?
  // Referring source (cascading: Practice > Location > Doctor)
  referringPracticeId  String?
  referringPractice    ReferringPractice? @relation(fields: [referringPracticeId], references: [id])
  referringLocationId  String?
  referringLocation    PracticeLocation?  @relation(fields: [referringLocationId], references: [id])
  referringDoctorId    String?
  referringDoctor      ReferringDoctor?   @relation(fields: [referringDoctorId], references: [id])
  referringDoctorName  String?            // free-text fallback if doctor not in system
  referringNpi         String?            // NPI of the referring provider
  referringPhone       String?            // direct contact for the referring source
  referringAddress     String?            // address of the referring source
  // Status pipeline
  status              ReferralStatus     @default(NEW)
  referralDate        DateTime           @default(now())
  appointmentDate     DateTime?
  // Insurance
  insuranceProvider   String?
  insuranceMemberId   String?
  insuranceGroup      String?
  authStatus          String?
  // Pipeline
  pipelineId          String?
  pipeline            Pipeline?          @relation(fields: [pipelineId], references: [id])
  imagingType         String?            // CT | MRI | MRI Arthrogram — only set for MRI pipeline referrals
  // Notes & meta
  notes               String?
  customProperties    Json               @default("{}") // custom property values
  createdById         String?
  createdBy           User?              @relation("ReferralCreatedBy", fields: [createdById], references: [id])
  assignedToId        String?
  assignedTo          User?              @relation("ReferralAssignedTo", fields: [assignedToId], references: [id])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  documents           Document[]
  outreachMessages    OutreachMessage[]
  tags                ReferralTag[]
  callAttempts        CallAttempt[]
  tasks               Task[]
  smsThreads          SmsThread[]
  sequenceEnrollments SequenceEnrollment[]
}

model CallAttempt {
  id         String      @id @default(cuid())
  referralId String
  referral   Referral    @relation(fields: [referralId], references: [id], onDelete: Cascade)
  outcome    CallOutcome
  notes      String?
  calledById String?
  calledBy   User?       @relation(fields: [calledById], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())

  @@index([referralId])
}

model ProviderNote {
  id         String          @id @default(cuid())
  content    String
  providerId String
  provider   ReferringDoctor @relation(fields: [providerId], references: [id], onDelete: Cascade)
  createdById String
  createdBy  User            @relation(fields: [createdById], references: [id])
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model Document {
  id           String   @id @default(cuid())
  referralId   String
  referral     Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  fileSize     Int?
  contentType  String?
  uploadedById String?
  createdAt    DateTime @default(now())
}

model AuditLog {
  id           String      @id @default(cuid())
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       AuditAction
  resourceType String?
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime    @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([resourceType, resourceId])
}

model OutreachMessage {
  id         String          @id @default(cuid())
  referralId String
  referral   Referral        @relation(fields: [referralId], references: [id], onDelete: Cascade)
  channel    OutreachChannel
  trigger    OutreachTrigger
  status     OutreachStatus
  recipient  String          // phone number or email — no PHI
  message    String
  error      String?
  sentById   String?
  sentBy     User?           @relation(fields: [sentById], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now())

  @@index([referralId])
  @@index([createdAt])
}

enum TagScope {
  REFERRAL
  ACTIVITY
}

model Tag {
  id         String        @id @default(cuid())
  name       String
  scope      TagScope      @default(REFERRAL)
  color      String        // hex color e.g. "#3b82f6"
  createdAt  DateTime      @default(now())
  referrals  ReferralTag[]
  activities ActivityTag[]

  @@unique([name, scope])
}

model ReferralTag {
  referralId String
  tagId      String
  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([referralId, tagId])
}

model EmailBroadcast {
  id             String                   @id @default(cuid())
  subject        String
  body           String
  fromSender     String                   @default("referrals")
  attachments    Json                     @default("[]")
  status         BroadcastStatus          @default(DRAFT)
  scheduledAt    DateTime?
  sentAt         DateTime?
  recipientCount Int                      @default(0)
  sentCount      Int                      @default(0)
  failedCount    Int                      @default(0)
  filters        Json?                    // stored filter criteria
  createdById    String?
  createdBy      User?                    @relation(fields: [createdById], references: [id])
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  recipients     EmailBroadcastRecipient[]

  @@index([status])
  @@index([scheduledAt])
}

model EmailBroadcastRecipient {
  id          String                 @id @default(cuid())
  broadcastId String
  broadcast   EmailBroadcast         @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  email       String
  name        String
  type        BroadcastRecipientType
  data        Json                   @default("{}") // personalization values for this recipient
  status      OutreachStatus         @default(SENT)
  error       String?
  sentAt      DateTime?
  createdAt   DateTime               @default(now())

  @@index([broadcastId])
}

model Task {
  id            String        @id @default(cuid())
  title         String
  description   String?
  dueDate       DateTime?
  priority      TaskPriority  @default(NORMAL)
  status        TaskStatus    @default(TODO)
  createdById   String
  createdBy     User          @relation("TaskCreatedBy", fields: [createdById], references: [id])
  assignedToId  String?
  assignedTo    User?         @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  referralId    String?
  referral      Referral?     @relation(fields: [referralId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  notifications Notification[]

  @@index([assignedToId])
  @@index([createdById])
  @@index([referralId])
  @@index([status])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  link      String?
  read      Boolean   @default(false)
  taskId    String?
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())

  @@index([userId, read])
  @@index([userId])
}

model Automation {
  id            String            @id @default(cuid())
  name          String
  description   String?
  isActive      Boolean           @default(true)
  triggerType   AutomationTrigger
  triggerConfig Json              @default("{}")
  actionType    AutomationAction
  actionConfig  Json              @default("{}")
  flow          Json?             // if/else branch: { match, rules[], then[], else[] }; null = single action
  graph         Json?             // visual flow graph: { rootId, nodes }; takes precedence when set
  createdById   String
  createdBy     User              @relation(fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  runs          AutomationRun[]
  resumes       WorkflowResume[]

  @@index([triggerType, isActive])
}

model AutomationRun {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  triggeredAt  DateTime   @default(now())
  contextType  String
  contextId    String
  result       String     // "success" | "skipped" | "error"
  detail       String?
  meta         Json?      // { recordLabel, recordType, steps: [{ label, status, error? }] }

  @@index([automationId])
  @@index([contextType, contextId])
}

// A workflow paused at a delay step, waiting to resume.
model WorkflowResume {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  resumeNodeId String     // node to continue from when resumed
  resumeAt     DateTime   // when to continue
  referralId   String?    // referral that referral-actions operate on (if any)
  recordLabel  String?
  vars         Json       // template vars captured at enrollment
  record       Json       // record snapshot for branch evaluation
  createdAt    DateTime   @default(now())

  @@index([resumeAt])
  @@index([automationId])
}

model Activity {
  id          String             @id @default(cuid())
  practiceId  String?
  practice    ReferringPractice? @relation(fields: [practiceId], references: [id], onDelete: SetNull)
  locationId  String?
  location    PracticeLocation?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  nextStep    String?
  date        DateTime           @default(now())
  frontDesk   String?
  flyer       String?
  notes       String?
  createdById String
  createdBy   User               @relation(fields: [createdById], references: [id])
  createdAt   DateTime           @default(now())
  providers   ActivityProvider[]
  tags        ActivityTag[]

  @@index([practiceId])
  @@index([locationId])
  @@index([createdAt])
}

model ProviderView {
  id            String   @id @default(cuid())
  name          String
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  config        Json
  visibility    String   @default("PRIVATE") // PRIVATE | EVERYONE | TEAM | CUSTOM
  teamId        String?
  sharedUserIds String[] @default([])
  createdAt     DateTime @default(now())

  @@index([userId])
}

model ActivityView {
  id            String   @id @default(cuid())
  name          String
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filters       Json
  visibility    String   @default("PRIVATE") // PRIVATE | EVERYONE | TEAM | CUSTOM
  teamId        String?
  sharedUserIds String[] @default([])
  createdAt     DateTime @default(now())

  @@index([userId])
}

model SurgeryView {
  id            String   @id @default(cuid())
  name          String
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  config        Json     // { query, columns, viewMode }
  visibility    String   @default("PRIVATE") // PRIVATE | EVERYONE | TEAM | CUSTOM
  teamId        String?
  sharedUserIds String[] @default([])
  createdAt     DateTime @default(now())

  @@index([userId])
}

model DirectEmail {
  id       String   @id @default(cuid())
  to       String[]
  cc       String[]
  bcc      String[]
  subject  String
  body     String
  sentAt   DateTime @default(now())
  success  Boolean  @default(true)
  error    String?
  sentById String
  sentBy   User     @relation(fields: [sentById], references: [id])

  @@index([sentAt])
}

model ActivityTag {
  activityId String
  tagId      String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([activityId, tagId])
}

model ActivityProvider {
  activityId String
  doctorId   String
  activity   Activity        @relation(fields: [activityId], references: [id], onDelete: Cascade)
  doctor     ReferringDoctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@id([activityId, doctorId])
}

enum IvrAction {
  PLAY_MESSAGE
  FORWARD_CALL
  HANG_UP
}

enum SmsDirection {
  INBOUND
  OUTBOUND
}

model SmsThread {
  id            String       @id @default(cuid())
  phone         String       // E.164 format e.g. +15551234567
  contactName   String?
  referralId    String?
  referral      Referral?    @relation(fields: [referralId], references: [id], onDelete: SetNull)
  lastMessageAt DateTime     @default(now())
  unreadCount   Int          @default(0)
  messages      SmsMessage[]
  createdAt     DateTime     @default(now())

  @@index([phone])
  @@index([lastMessageAt])
}

model SmsMessage {
  id         String        @id @default(cuid())
  threadId   String
  thread     SmsThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  body       String
  direction  SmsDirection
  status     String?       // sent | delivered | failed | received
  twilioSid  String?       @unique
  sentById   String?
  sentBy     User?         @relation(fields: [sentById], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())

  @@index([threadId, createdAt])
}

model CompletedAppointment {
  id                       String    @id @default(cuid())
  patientName              String
  mrn                      String?
  phone                    String?
  email                    String?
  appointmentDate          DateTime?
  referringProvider        String
  referringProviderAddress String?
  referringProviderPhone   String?
  importBatchId            String?
  importedAt               DateTime  @default(now())
  createdById              String?
  createdBy                User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([referringProvider])
  @@index([importedAt])
  @@index([importBatchId])
}

model OrgNameRule {
  id             String   @id @default(cuid())
  contains       String   // case-insensitive substring to match
  normalizedName String   // canonical practice name to resolve to
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([order])
}

model IvrConfig {
  id             String      @id @default(cuid())
  isActive       Boolean     @default(false)
  greeting       String      @default("Thank you for calling. Please listen to the following options.")
  noInputMessage String      @default("We did not receive your input. Goodbye.")
  invalidMessage String      @default("That is not a valid option. Please try again.")
  gatherTimeout  Int         @default(5)
  options        IvrOption[]
  updatedAt      DateTime    @updatedAt
  createdAt      DateTime    @default(now())
}

model IvrOption {
  id        String    @id @default(cuid())
  configId  String
  config    IvrConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  digit     String    // "1"–"9", "0"
  label     String
  action    IvrAction
  message   String?   // for PLAY_MESSAGE
  forwardTo String?   // for FORWARD_CALL
  order     Int       @default(0)
}

model SmsAutoResponse {
  id          String   @id @default(cuid())
  isActive    Boolean  @default(true)
  trigger     String   // keyword e.g. "YES", "1", "CANCEL"
  matchType   String   @default("exact") // exact | contains | starts_with
  response    String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Sequences (drip campaigns) ───────────────────────────────────────────────

enum StepChannel {
  SMS
  EMAIL
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum StepRunStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model Sequence {
  id            String               @id @default(cuid())
  name          String
  description   String?
  isActive      Boolean              @default(true)
  trigger       String               @default("ON_STATUS_CHANGE") // ON_STATUS_CHANGE | ON_CREATE | MANUAL
  triggerStatus ReferralStatus?
  filters       Json                 @default("{}")               // { referringPracticeId?, insuranceProvider? }
  steps         SequenceStep[]
  enrollments   SequenceEnrollment[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model SequenceStep {
  id         String            @id @default(cuid())
  sequenceId String
  sequence   Sequence          @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  order      Int
  delayDays  Int               @default(0)
  channel     StepChannel
  subject     String?
  body        String
  fromSender  String            @default("referrals")
  attachments Json              @default("[]")
  runs        SequenceStepRun[]
  createdAt  DateTime          @default(now())

  @@index([sequenceId, order])
}

model SequenceEnrollment {
  id         String           @id @default(cuid())
  sequenceId String
  sequence   Sequence         @relation(fields: [sequenceId], references: [id])
  referralId String
  referral   Referral         @relation(fields: [referralId], references: [id], onDelete: Cascade)
  enrolledAt DateTime         @default(now())
  status     EnrollmentStatus @default(ACTIVE)
  stepRuns   SequenceStepRun[]

  @@unique([sequenceId, referralId])
  @@index([referralId])
}

model SequenceStepRun {
  id           String             @id @default(cuid())
  enrollmentId String
  enrollment   SequenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stepId       String
  step         SequenceStep       @relation(fields: [stepId], references: [id])
  scheduledAt  DateTime
  sentAt       DateTime?
  status       StepRunStatus      @default(PENDING)
  error        String?
  createdAt    DateTime           @default(now())

  @@index([status, scheduledAt])
}

// ── Staff Scheduler ───────────────────────────────────────────────────────────

enum StaffRole {
  XR_TECH
  MA
  FD
}

enum SchedDay {
  MON
  TUE
  WED
  THU
  FRI
}

enum AvailabilityType {
  AVAILABLE
  LAST_RESORT
  UNAVAILABLE
}

model ScheduleLocation {
  id               String                    @id @default(cuid())
  code             String                    @unique
  name             String
  openDays         String[]                  @default([])
  order            Int
  entries          ScheduleEntry[]
  staffAssignments StaffLocationAssignment[]
  requirements     LocationRoleRequirement[]

  @@index([order])
}

model LocationRoleRequirement {
  id         String           @id @default(cuid())
  locationId String
  location   ScheduleLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  role       StaffRole
  countMon   Int              @default(0)
  countTue   Int              @default(0)
  countWed   Int              @default(0)
  countThu   Int              @default(0)
  countFri   Int              @default(0)

  @@unique([locationId, role])
}

model StaffMember {
  id                String                   @id @default(cuid())
  name              String
  primaryRole       StaffRole
  roles             StaffRole[]              @default([])
  isLastResort      Boolean                  @default(false)
  isActive          Boolean                  @default(true)
  availability      StaffAvailability[]
  entries           ScheduleEntry[]
  locationAssignments StaffLocationAssignment[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
}

model StaffLocationAssignment {
  staffId    String
  locationId String
  staff      StaffMember      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  location   ScheduleLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([staffId, locationId])
}

model StaffAvailability {
  id      String           @id @default(cuid())
  staffId String
  staff   StaffMember      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  day     SchedDay
  type    AvailabilityType @default(AVAILABLE)

  @@unique([staffId, day])
}

model WeeklySchedule {
  id          String          @id @default(cuid())
  weekOf      DateTime        @db.Date
  notes       String?
  isPublished Boolean         @default(false)
  entries     ScheduleEntry[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([weekOf])
}

model ScheduleEntry {
  id           String           @id @default(cuid())
  scheduleId   String
  schedule     WeeklySchedule   @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  locationId   String
  location     ScheduleLocation @relation(fields: [locationId], references: [id])
  staffId      String
  staff        StaffMember      @relation(fields: [staffId], references: [id])
  assignedRole StaffRole
  day          SchedDay
  createdAt    DateTime         @default(now())

  @@unique([scheduleId, locationId, staffId, day])
  @@index([scheduleId, day])
}

model OutreachTemplate {
  id        String          @id @default(cuid())
  trigger   OutreachTrigger
  channel   OutreachChannel
  subject   String?         // email subject line (email only)
  body      String
  isActive  Boolean         @default(true)
  updatedAt DateTime        @updatedAt
  createdAt DateTime        @default(now())

  @@unique([trigger, channel])
}

// Reusable marketing templates (SMS / Email) managed under the Marketing section.
model MessageTemplate {
  id             String          @id @default(cuid())
  name           String
  channel        OutreachChannel
  subject        String?         // email subject (email only)
  body           String
  isActive       Boolean         @default(true)
  createdById    String?
  updatedById    String?
  lastViewedById String?
  lastViewedAt   DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([channel])
}

model SavedReport {
  id          String            @id @default(cuid())
  name        String
  config      Json
  isPinned    Boolean           @default(false)
  createdById String
  createdBy   User              @relation("SavedReportCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  dashboards  DashboardReport[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Dashboard {
  id          String            @id @default(cuid())
  name        String
  createdById String
  createdBy   User              @relation("DashboardCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  reports     DashboardReport[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model DashboardReport {
  dashboardId   String
  savedReportId String
  order         Int          @default(0)
  addedAt       DateTime     @default(now())
  dashboard     Dashboard    @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  savedReport   SavedReport  @relation(fields: [savedReportId], references: [id], onDelete: Cascade)

  @@id([dashboardId, savedReportId])
}

// ─── Surgery ──────────────────────────────────────────────────────────────────

enum SurgeryStatus {
  NEW
  SCHEDULED
  PENDING_CONFIRMATION
  PENDING_CLEARANCE
  CANCELED
  COMPLETED
}

model SurgeryCase {
  id                String         @id @default(cuid())
  mrn               String?
  expires           DateTime?
  creationDate      DateTime?
  status            SurgeryStatus  @default(NEW)
  patientName       String
  orderingProvider  String?
  diagnosis         String?
  medicalClearance   String?
  secondaryClearance String?
  dentalClearance    String?
  ctRequired        String?
  glp1              String?
  dme               String?
  physicalTherapy       String?    // Internal/GOSM | External | NA | Undecided
  physicalTherapyDetail String?    // free text shown when physicalTherapy = External
  referral          String?
  facility          String?
  procedure         String?
  surgeryDate       DateTime?
  language          String?        @default("EN")
  email             String?
  notes             String?
  createdById       String?
  createdBy         User?          @relation("SurgeryCaseCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  callAttempts      SurgeryCallAttempt[]
  documents         SurgeryDocument[]
}

model SurgeryCallAttempt {
  id          String       @id @default(cuid())
  caseId      String
  case        SurgeryCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  calledById  String?
  calledBy    User?        @relation("SurgeryCallAttemptCalledBy", fields: [calledById], references: [id])
  outcome     CallOutcome  @default(NO_ANSWER)
  notes       String?
  createdAt   DateTime     @default(now())

  @@index([caseId])
}

model SurgeryDocument {
  id           String      @id @default(cuid())
  caseId       String
  case         SurgeryCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  fileSize     Int?
  contentType  String?
  uploadedById String?
  uploadedBy   User?       @relation("SurgeryDocumentUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime    @default(now())

  @@index([caseId])
}

model MarketingCategory {
  id        String          @id @default(cuid())
  name      String
  order     Int             @default(0)
  createdAt DateTime        @default(now())
  items     MarketingItem[]
}

model MarketingItem {
  id          String            @id @default(cuid())
  categoryId  String
  category    MarketingCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title       String
  description String?
  fileUrl     String
  fileName    String
  createdAt   DateTime          @default(now())
  orders      MarketingOrder[]

  @@index([categoryId])
}

model MarketingOrder {
  id        String        @id @default(cuid())
  itemId    String
  item      MarketingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name      String
  email     String
  quantity  Int
  address   String
  status    String        @default("PENDING")
  createdAt DateTime      @default(now())

  @@index([itemId])
  @@index([status])
}

model MarketingConfig {
  id          String @id @default("singleton")
  notifyEmail String @default("")
}

