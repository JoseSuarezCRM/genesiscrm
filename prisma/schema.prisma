// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  STAFF
}

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

enum BroadcastRecipientType {
  PATIENT
  PROVIDER
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGIN_LOCKED
  LOGOUT
  REFERRAL_VIEW
  REFERRAL_CREATE
  REFERRAL_UPDATE
  REFERRAL_DELETE
  DOCUMENT_UPLOAD
  DOCUMENT_VIEW
  DOCUMENT_DELETE
  EXPORT_CSV
  USER_CREATE
  USER_UPDATE
  USER_DELETE
  PASSWORD_RESET
  OUTREACH_SENT
}

enum OutreachChannel {
  SMS
  EMAIL
}

enum OutreachTrigger {
  MANUAL
  STATUS_SCHEDULED
  STATUS_COMPLETED
  REMINDER_24HR
}

enum OutreachStatus {
  SENT
  FAILED
}

enum CallOutcome {
  NO_ANSWER
  VOICEMAIL
  ANSWERED
}

enum AutomationTrigger {
  REFERRAL_CREATED
  REFERRAL_STATUS_CHANGED
  PROVIDER_REFERRAL_COUNT
  PRACTICE_REFERRAL_COUNT
  REFERRAL_NO_ACTIVITY
  APPOINTMENT_UPCOMING
  CALL_ATTEMPTS_REACHED
  REFERRAL_ASSIGNED
  APPOINTMENT_OVERDUE
  REFERRAL_STALE
  TAG_ADDED
  DOCUMENT_UPLOADED
  AUTH_STATUS_CHANGED
  LOCATION_REFERRAL_COUNT
  EMBED_REFERRAL_RECEIVED
  PIPELINE_CHANGED
  SURGERY_STATUS_CHANGED
  SURGERY_CALL_ATTEMPTS_REACHED
  // Generic, object-agnostic triggers: work for any built-in object or custom
  // object. The object is named in triggerConfig.objectType (e.g. "SURGERY",
  // "CO:visits").
  RECORD_CREATED
  RECORD_PROPERTY_CHANGED
  RECORD_OWNER_CHANGED
  // Engagement triggers
  SMS_RECEIVED       // inbound text from a patient
  ENGAGEMENT_LOGGED  // note / call / meeting logged on a record
  TASK_OVERDUE       // task past its due date and still open
}

enum AutomationAction {
  CREATE_TASK
  SEND_NOTIFICATION
  SEND_EMAIL
  SEND_SMS
  SEND_MEETING_INVITE
  UPDATE_REFERRAL_STATUS
  ASSIGN_REFERRAL
  ADD_TAG
  // Generic writes against the record that triggered the workflow — these work
  // on any object, including custom properties.
  SET_PROPERTY
  COPY_PROPERTY
  ASSIGN_OWNER
  // Create a new record in another object (custom objects), optionally associating
  // it with the triggering record.
  CREATE_RECORD
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING
  COMPLETED
  DEFERRED
}

enum TaskType {
  TODO
  CALL
  EMAIL
}

enum TaskRepeat {
  NONE
  DAILY
  WEEKDAYS
  WEEKLY
  MONTHLY
}

enum ReferralStatus {
  NEW
  READY_FOR_CALL
  CONTACTED
  SCHEDULED
  COMPLETED
  NO_SHOW
  LOST
}

enum CustomPropertyType {
  TEXT
  LONG_TEXT
  NUMBER
  EMAIL
  PHONE
  DATE
  DATE_TIME
  CHECKBOX
  DROPDOWN
  MULTI_SELECT
  URL
}

enum CustomPropertyEntityType {
  REFERRAL
  PROVIDER
  PRACTICE
  LOCATION
  SURGERY
  ACTIVITY
  TASK
}

model CustomProperty {
  id           String                     @id @default(cuid())
  name         String                     // e.g., "Surgery Type", "Insurance Plan"
  internalName String?                    // token slug, e.g. "surgery_type" (unique per entity)
  type         CustomPropertyType
  entityType   CustomPropertyEntityType
  required     Boolean                    @default(false)
  unique       Boolean                    @default(false)  // require unique values across records
  description  String?
  defaultValue String?                                     // pre-filled on new records
  options      String[]                   @default([])  // DROPDOWN/MULTI_SELECT: the stable internal VALUES records store
  optionLabels Json?                                       // { [value]: displayLabel } — rename labels without breaking records
  optionColors Json?                                       // DROPDOWN/MULTI_SELECT: { [value]: hexColor }
  optionStyle  String?                                     // DROPDOWN/MULTI_SELECT: "default" | "dot" | "badge"
  conditional  Json?                                       // { controllingPropertyId, rules: { value: [opts] } }
  visibilityRule Json?                                      // { controllingKey, equals: [values] } — show only when the controlling field's value is one of these
  numberFormat String?                                      // NUMBER only: "currency" or null (plain)
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  @@unique([name, entityType])
  @@unique([internalName, entityType])
}

// ── Custom objects (HubSpot-style) ───────────────────────────────────────────
// An admin-defined object type. Its property schema lives in `properties` (JSON)
// so no per-object table is needed. Records are CustomObjectRecord rows.
model CustomObjectDef {
  id          String   @id @default(cuid())
  key         String   @unique              // url slug, e.g. "visits"
  singular    String                        // "Visit"
  plural      String                        // "Visits"
  icon        String?                       // lucide icon name
  ownerLabel  String                        // "Visit Owner"
  // [{ id, name, type, options?, required?, primary? }] — the record schema.
  properties  Json     @default("[]")
  // [{ id, title, column: "LEFT"|"MIDDLE", propertyIds: string[] }] — detail card layout.
  cards       Json     @default("[]")
  order       Int      @default(0)          // nav ordering
  createdById String?
  createdBy   User?    @relation("CustomObjectDefCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  records     CustomObjectRecord[]
}

model CustomObjectRecord {
  id             String          @id @default(cuid())
  recordNumber   Int?            // per-object sequential "Record ID" (unique id)
  objectDefId    String
  objectDef      CustomObjectDef @relation(fields: [objectDefId], references: [id], onDelete: Cascade)
  values         Json            @default("{}") // { propertyId: value }
  // Default properties every record gets:
  ownerId        String?         // Record Owner (defaults to creator)
  owner          User?           @relation("CustomObjectRecordOwner", fields: [ownerId], references: [id])
  createdById    String?
  createdBy      User?           @relation("CustomObjectRecordCreatedBy", fields: [createdById], references: [id])
  updatedById    String?         // resolved to a name at read time
  lastViewedById String?
  lastViewedAt   DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([objectDefId, recordNumber])
  @@index([objectDefId])
}

// ── Data model: associations between objects (custom + built-in) ─────────────
// A defined relationship between two object types. `typeA`/`typeB` are registry
// keys: "CO:<key>" for custom objects, or a built-in like "REFERRAL"/"PROVIDER".
model ObjectAssociationDef {
  id        String   @id @default(cuid())
  typeA     String
  typeB     String
  label     String?
  createdAt DateTime @default(now())

  @@unique([typeA, typeB])
}

// A link between two specific records (heterogeneous — no FKs).
// A note on any record (custom or built-in) — the first engagement type in the
// unified activity feed. recordType is a registry key ("CO:<key>" or built-in).
// A file/document attached to any record (built-in or custom). recordType is a
// registry key ("PROVIDER", "CO:<key>", …). Bytes live in the private Blob store;
// served through the authenticated /api/record-attachments/[id] route.
model RecordAttachment {
  id          String   @id @default(cuid())
  recordType  String
  recordId    String
  name        String
  blobUrl     String   // private Blob url (read server-side with the token)
  contentType String
  size        Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())

  @@index([recordType, recordId])
}

// Logged engagements on any record: notes, call logs and meetings.
model RecordNote {
  id          String    @id @default(cuid())
  recordType  String
  recordId    String
  kind        String    @default("NOTE") // NOTE | CALL | MEETING
  title       String?
  body        String
  occurredAt  DateTime? // call time / meeting start
  meta        Json? // outcome, duration, attendees, location…
  createdById String?
  createdBy   User?     @relation("RecordNoteCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([recordType, recordId])
}

// Property cards for objects that aren't in the CustomPropertyEntityType enum —
// i.e. custom objects ("CO:visits"). Built-in objects keep using CardLayout; both
// are read/written through the same actions so the UI is identical.
model RecordCard {
  id         String   @id @default(cuid())
  objectType String
  cardName   String
  title      String
  fields     String[] @default([])
  section    String   @default("LEFT") // LEFT | MIDDLE
  columns    Int      @default(1) // fields laid out N-across (middle column)
  kind       String   @default("PROPERTIES") // PROPERTIES | CALL_LOG
  config     Json?
  visible    Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([objectType, cardName])
}

// Which association cards show in a record page's right column. Keyed by registry
// key, so it works for built-in objects AND custom objects ("CO:visits") alike.
model AssociationCardPref {
  id         String  @id @default(cuid())
  objectType String
  cardType   String
  visible    Boolean @default(true)
  order      Int     @default(0)
  fields     Json?   // ordered field keys of the associated object to show on the card

  @@unique([objectType, cardType])
}

model ObjectAssociation {
  id        String   @id @default(cuid())
  fromType  String
  fromId    String
  toType    String
  toId      String
  createdAt DateTime @default(now())

  @@unique([fromType, fromId, toType, toId])
  @@index([fromType, fromId])
  @@index([toType, toId])
}

// A record-import run, kept so it can be undone (delete created records, restore
// prior values on updated ones, remove associations it added).
model ImportRun {
  id          String   @id @default(cuid())
  objectKey   String   // custom object key imported into
  status      String   @default("active") // active | undone
  created     Int      @default(0)
  updated     Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  undoneAt    DateTime?

  @@index([objectKey, createdAt])
}

// One created/updated record in an import run. `before` holds the prior values of
// exactly the fields the import wrote (for restore); null on creates.
model ImportRunChange {
  id       String  @id @default(cuid())
  runId    String
  kind     String  // create | update
  recordId String
  before   Json?

  @@index([runId])
}

// An association an import run newly created (so undo removes only those).
model ImportRunAssoc {
  id       String @id @default(cuid())
  runId    String
  fromType String
  fromId   String
  toType   String
  toId     String

  @@index([runId])
}

model CustomObjectView {
  id            String   @id @default(cuid())
  objectKey     String                    // which custom object this view belongs to
  name          String
  userId        String
  user          User     @relation("CustomObjectViewCreatedBy", fields: [userId], references: [id], onDelete: Cascade)
  config        Json                       // { filter, columns }
  visibility    String   @default("PRIVATE") // PRIVATE | EVERYONE | TEAM | CUSTOM
  teamId        String?
  sharedUserIds String[] @default([])
  createdAt     DateTime @default(now())

  @@index([objectKey])
  @@index([userId])
}

model PropertyDisplayConfig {
  id               String                     @id @default(cuid())
  customPropertyId String
  entityType       CustomPropertyEntityType
  visible          Boolean                    @default(true)
  order            Int                        @default(0)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@unique([customPropertyId, entityType])
}

model CardLayout {
  id               String                     @id @default(cuid())
  entityType       CustomPropertyEntityType
  cardName         String
  title            String
  fields           String[]                   @default([])
  section          String                     @default("RIGHT") // LEFT (properties sidebar) or RIGHT (associated objects)
  columns          Int                        @default(1) // fields laid out N-across (middle column)
  kind             String                     @default("PROPERTIES") // PROPERTIES | CALL_LOG
  config           Json?                       // card-type settings (e.g. { maxCalls })
  visible          Boolean                    @default(true)
  order            Int                        @default(0)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@unique([entityType, cardName])
}

model User {
  id                    String         @id @default(cuid())
  email                 String         @unique
  name                  String?
  password              String
  role                  Role           @default(STAFF)
  permissions           String[]       @default([])
  createdAt             DateTime       @default(now())
  // HIPAA security fields
  failedLoginAttempts   Int            @default(0)
  lockedUntil           DateTime?
  lastLoginAt           DateTime?
  isActive              Boolean        @default(true)
  // Invite flow: a pending user is created with isActive=false + a token; they
  // set their own password via the accept-invite link, which activates them.
  inviteToken           String?        @unique
  inviteTokenExpires    DateTime?
  // Notification preferences
  notifyOnEmbedReferral Boolean        @default(false)
  // When on, the user can send app emails from their own @genesisortho.com
  // mailbox (via the org's Microsoft 365 connection — no separate credentials).
  emailSendingEnabled   Boolean        @default(false)
  referralsCreated      Referral[]     @relation("ReferralCreatedBy")
  referralsAssigned     Referral[]     @relation("ReferralAssignedTo")
  providerNotes         ProviderNote[]
  auditLogs             AuditLog[]
  outreachMessages      OutreachMessage[]
  emailBroadcasts       EmailBroadcast[]
  callAttempts          CallAttempt[]
  tasksCreated          Task[]         @relation("TaskCreatedBy")
  tasksAssigned         Task[]         @relation("TaskAssignedTo")
  notifications         Notification[]
  automations           Automation[]
  activities            Activity[]
  completedAppointments CompletedAppointment[]
  smsMessages           SmsMessage[]
  teamMemberships       TeamMember[]
  directEmails          DirectEmail[]
  activityViews         ActivityView[]
  providerViews         ProviderView[]
  surgeryViews          SurgeryView[]
  taskViews             TaskView[]
  referralViews         ReferralView[]
  viewOrders            UserViewOrder[]
  savedReports          SavedReport[]        @relation("SavedReportCreatedBy")
  dashboards            Dashboard[]          @relation("DashboardCreatedBy")
  surgeryCases          SurgeryCase[]        @relation("SurgeryCaseCreatedBy")
  surgeryCallAttempts   SurgeryCallAttempt[] @relation("SurgeryCallAttemptCalledBy")
  surgeryDocuments      SurgeryDocument[]    @relation("SurgeryDocumentUploadedBy")
  customObjectDefs      CustomObjectDef[]    @relation("CustomObjectDefCreatedBy")
  customRecordsCreated  CustomObjectRecord[] @relation("CustomObjectRecordCreatedBy")
  customRecordsOwned    CustomObjectRecord[] @relation("CustomObjectRecordOwner")
  customObjectViews     CustomObjectView[]   @relation("CustomObjectViewCreatedBy")
  recordNotes           RecordNote[]         @relation("RecordNoteCreatedBy")

  // Record ownership + audit trail on the built-in objects
  providersOwned        ReferringDoctor[]    @relation("ProviderOwner")
  providersCreated      ReferringDoctor[]    @relation("ProviderCreatedBy")
  providersUpdated      ReferringDoctor[]    @relation("ProviderUpdatedBy")
  practicesOwned        ReferringPractice[]  @relation("PracticeOwner")
  practicesCreated      ReferringPractice[]  @relation("PracticeCreatedBy")
  practicesUpdated      ReferringPractice[]  @relation("PracticeUpdatedBy")
  locationsOwned        PracticeLocation[]   @relation("LocationOwner")
  locationsCreated      PracticeLocation[]   @relation("LocationCreatedBy")
  locationsUpdated      PracticeLocation[]   @relation("LocationUpdatedBy")
  surgeryCasesOwned     SurgeryCase[]        @relation("SurgeryCaseOwner")
  surgeryCasesUpdated   SurgeryCase[]        @relation("SurgeryCaseUpdatedBy")
  activitiesOwned       Activity[]           @relation("ActivityOwner")
  activitiesUpdated     Activity[]           @relation("ActivityUpdatedBy")
  tasksUpdated          Task[]               @relation("TaskUpdatedBy")
}

model Team {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  permissions String[]     @default([])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     TeamMember[]
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  userId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model ReferringPractice {
  id                 String             @id @default(cuid())
  name               String
  phone              String?
  fax                String?
  address            String?
  customProperties   Json               @default("{}") // custom property values
  ownerId            String?
  owner              User?              @relation("PracticeOwner", fields: [ownerId], references: [id])
  createdById        String?
  createdBy          User?              @relation("PracticeCreatedBy", fields: [createdById], references: [id])
  updatedById        String?
  updatedBy          User?              @relation("PracticeUpdatedBy", fields: [updatedById], references: [id])
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now()) @updatedAt
  locations          PracticeLocation[]
  doctors            ReferringDoctor[]
  referrals          Referral[]
  activities         Activity[]
}

// A specific office/campus of a practice
model PracticeLocation {
  id               String            @id @default(cuid())
  name             String            // e.g. "Main Office", "North Campus"
  phone            String?
  fax              String?
  address          String?
  customProperties Json              @default("{}") // custom property values
  practiceId String
  practice   ReferringPractice @relation(fields: [practiceId], references: [id])
  doctors    DoctorLocation[]
  referrals  Referral[]
  activities Activity[]

  ownerId     String?
  owner       User?    @relation("LocationOwner", fields: [ownerId], references: [id])
  createdById String?
  createdBy   User?    @relation("LocationCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?    @relation("LocationUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

enum ContactType {
  PROVIDER
  STAFF
}

// A provider — belongs to one practice, can work at multiple locations
model ReferringDoctor {
  id                 String             @id @default(cuid())
  name               String
  title              String?            // MD, DO, NP, PA-C, DPM, etc.
  npi                String?            // National Provider Identifier (10 digits)
  specialty          String?
  phone              String?
  officePhone        String?            // office / practice direct line
  email              String?
  contactType        ContactType        @default(PROVIDER)
  customProperties   Json               @default("{}") // custom property values
  practiceId         String
  practice           ReferringPractice  @relation(fields: [practiceId], references: [id])
  locations          DoctorLocation[]
  referrals          Referral[]
  providerNotes      ProviderNote[]
  activities         ActivityProvider[]

  ownerId     String?
  owner       User?    @relation("ProviderOwner", fields: [ownerId], references: [id])
  createdById String?
  createdBy   User?    @relation("ProviderCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?    @relation("ProviderUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

// Join table: doctor <-> location (many-to-many)
model DoctorLocation {
  doctorId   String
  locationId String
  doctor     ReferringDoctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  location   PracticeLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([doctorId, locationId])
}

model Pipeline {
  id        String     @id @default(cuid())
  name      String     @unique
  color     String     @default("#3b82f6")
  order     Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  referrals Referral[]
}

model Referral {
  id                  String             @id @default(cuid())
  // Patient info
  patientFirstName    String
  patientLastName     String
  patientMrn          String?            // Medical Record Number (from referring source/fax)
  genesisMrn          String?            // Internal Genesis Ortho MRN
  patientPhone        String?
  patientEmail        String?
  patientDob          DateTime?
  // Referring source (cascading: Practice > Location > Doctor)
  referringPracticeId  String?
  referringPractice    ReferringPractice? @relation(fields: [referringPracticeId], references: [id])
  referringLocationId  String?
  referringLocation    PracticeLocation?  @relation(fields: [referringLocationId], references: [id])
  referringDoctorId    String?
  referringDoctor      ReferringDoctor?   @relation(fields: [referringDoctorId], references: [id])
  referringDoctorName  String?            // free-text fallback if doctor not in system
  referringNpi         String?            // NPI of the referring provider
  referringPhone       String?            // direct contact for the referring source
  referringAddress     String?            // address of the referring source
  // Status pipeline
  status              ReferralStatus     @default(NEW)
  referralDate        DateTime           @default(now())
  appointmentDate     DateTime?
  // Insurance
  insuranceProvider   String?
  insuranceMemberId   String?
  insuranceGroup      String?
  authStatus          String?
  // Pipeline
  pipelineId          String?
  pipeline            Pipeline?          @relation(fields: [pipelineId], references: [id])
  imagingType         String?            // CT | MRI | MRI Arthrogram — only set for MRI pipeline referrals
  // Notes & meta
  notes               String?
  customProperties    Json               @default("{}") // custom property values
  createdById         String?
  createdBy           User?              @relation("ReferralCreatedBy", fields: [createdById], references: [id])
  assignedToId        String?
  assignedTo          User?              @relation("ReferralAssignedTo", fields: [assignedToId], references: [id])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  documents           Document[]
  outreachMessages    OutreachMessage[]
  tags                ReferralTag[]
  callAttempts        CallAttempt[]
  tasks               Task[]
  smsThreads          SmsThread[]
  sequenceEnrollments SequenceEnrollment[]
}

model CallAttempt {
  id         String      @id @default(cuid())
  referralId String
  referral   Referral    @relation(fields: [referralId], references: [id], onDelete: Cascade)
  outcome    CallOutcome
  notes      String?
  calledById String?
  calledBy   User?       @relation(fields: [calledById], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())

  @@index([referralId])
}

model ProviderNote {
  id         String          @id @default(cuid())
  content    String
  providerId String
  provider   ReferringDoctor @relation(fields: [providerId], references: [id], onDelete: Cascade)
  createdById String
  createdBy  User            @relation(fields: [createdById], references: [id])
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model Document {
  id           String   @id @default(cuid())
  referralId   String
  referral     Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  fileSize     Int?
  contentType  String?
  uploadedById String?
  createdAt    DateTime @default(now())
}

model AuditLog {
  id           String      @id @default(cuid())
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       AuditAction
  resourceType String?
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime    @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([resourceType, resourceId])
}

model OutreachMessage {
  id         String          @id @default(cuid())
  referralId String
  referral   Referral        @relation(fields: [referralId], references: [id], onDelete: Cascade)
  channel    OutreachChannel
  trigger    OutreachTrigger
  status     OutreachStatus
  recipient  String          // phone number or email — no PHI
  message    String
  error      String?
  sentById   String?
  sentBy     User?           @relation(fields: [sentById], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now())

  @@index([referralId])
  @@index([createdAt])
}

enum TagScope {
  REFERRAL
  ACTIVITY
}

model Tag {
  id         String        @id @default(cuid())
  name       String
  scope      TagScope      @default(REFERRAL)
  color      String        // hex color e.g. "#3b82f6"
  createdAt  DateTime      @default(now())
  referrals  ReferralTag[]
  activities ActivityTag[]

  @@unique([name, scope])
}

model ReferralTag {
  referralId String
  tagId      String
  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([referralId, tagId])
}

model EmailBroadcast {
  id             String                   @id @default(cuid())
  subject        String
  body           String
  fromSender     String                   @default("referrals")
  attachments    Json                     @default("[]")
  status         BroadcastStatus          @default(DRAFT)
  scheduledAt    DateTime?
  sentAt         DateTime?
  recipientCount Int                      @default(0)
  sentCount      Int                      @default(0)
  failedCount    Int                      @default(0)
  filters        Json?                    // stored filter criteria
  createdById    String?
  createdBy      User?                    @relation(fields: [createdById], references: [id])
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  recipients     EmailBroadcastRecipient[]

  @@index([status])
  @@index([scheduledAt])
}

model EmailBroadcastRecipient {
  id          String                 @id @default(cuid())
  broadcastId String
  broadcast   EmailBroadcast         @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  email       String
  name        String
  type        BroadcastRecipientType
  data        Json                   @default("{}") // personalization values for this recipient
  status      OutreachStatus         @default(SENT)
  error       String?
  sentAt      DateTime?
  createdAt   DateTime               @default(now())

  @@index([broadcastId])
}

model Task {
  id            String        @id @default(cuid())
  title         String
  description   String?
  dueDate       DateTime?
  priority      TaskPriority  @default(NORMAL)
  status        TaskStatus    @default(NOT_STARTED)
  type          TaskType      @default(TODO)
  repeat        TaskRepeat    @default(NONE)
  // Minutes before dueDate to fire a reminder (0 = at due time); null = no reminder.
  reminderMinutesBefore Int?
  reminderSentAt DateTime?
  queueId       String?
  queue         TaskQueue?    @relation(fields: [queueId], references: [id], onDelete: SetNull)
  createdById   String
  createdBy     User          @relation("TaskCreatedBy", fields: [createdById], references: [id])
  assignedToId  String?
  assignedTo    User?         @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  referralId    String?
  referral      Referral?     @relation(fields: [referralId], references: [id], onDelete: SetNull)
  customProperties Json       @default("{}") // custom property values
  updatedById   String?
  updatedBy     User?         @relation("TaskUpdatedBy", fields: [updatedById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  notifications Notification[]

  @@index([assignedToId])
  @@index([createdById])
  @@index([referralId])
  @@index([queueId])
  @@index([status])
}

model TaskQueue {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  tasks     Task[]
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  link      String?
  read      Boolean   @default(false)
  taskId    String?
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())

  @@index([userId, read])
  @@index([userId])
}

model Automation {
  id            String            @id @default(cuid())
  name          String
  description   String?
  isActive      Boolean           @default(true)
  triggerType   AutomationTrigger
  triggerConfig Json              @default("{}")
  actionType    AutomationAction
  actionConfig  Json              @default("{}")
  flow          Json?             // if/else branch: { match, rules[], then[], else[] }; null = single action
  graph         Json?             // visual flow graph: { rootId, nodes }; takes precedence when set
  createdById   String
  createdBy     User              @relation(fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  runs          AutomationRun[]
  resumes       WorkflowResume[]

  @@index([triggerType, isActive])
}

model AutomationRun {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  triggeredAt  DateTime   @default(now())
  contextType  String
  contextId    String
  result       String     // "success" | "skipped" | "error"
  detail       String?
  meta         Json?      // { recordLabel, recordType, steps: [{ label, status, error? }] }

  @@index([automationId])
  @@index([contextType, contextId])
}

// A workflow paused at a delay step, waiting to resume.
model WorkflowResume {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  resumeNodeId String     // node to continue from when resumed
  resumeAt     DateTime   // when to continue
  referralId   String?    // referral that referral-actions operate on (if any)
  recordType   String?    // generic record the workflow acts on (e.g. "CO:visits")
  recordId     String?
  recordLabel  String?
  vars         Json       // template vars captured at enrollment
  record       Json       // record snapshot for branch evaluation
  createdAt    DateTime   @default(now())

  @@index([resumeAt])
  @@index([automationId])
}

model Activity {
  id          String             @id @default(cuid())
  practiceId  String?
  practice    ReferringPractice? @relation(fields: [practiceId], references: [id], onDelete: SetNull)
  locationId  String?
  location    PracticeLocation?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  nextStep    String?
  date        DateTime           @default(now())
  frontDesk   String?
  flyer       String?
  notes       String?
  rating      Int?               // clinic value: 1 Low / 2 Mid / 3 High
  meetingRating Int?             // meeting rating: 1 (lowest) … 5 (highest)
  customProperties Json          @default("{}") // custom property values
  ownerId     String?
  owner       User?              @relation("ActivityOwner", fields: [ownerId], references: [id])
  createdById String
  createdBy   User               @relation(fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?              @relation("ActivityUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @default(now()) @updatedAt
  providers   ActivityProvider[]
  tags        ActivityTag[]

  @@index([practiceId])
  @@index([locationId])
  @@index([createdAt])
}

model ProviderView {
  id            String   @id @default(cuid())
  name          String
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  config        Json
  visibility    String   @default("PRIVATE") // PRIVATE | EVERYONE | TEAM | CUSTOM
  teamId        String?
  sharedUserIds String[] @default([])
  createdAt     DateTime @default(now())

  @@index([userId])
}

model ActivityView {
  id            String   @id @default(cuid())
  name          String
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filters       Json
  visibility    String   @default("PRIVATE") // PRIVATE | EVERYONE | TEAM | CUSTOM
  teamId        String?
  sharedUserIds String[] @default([])
  createdAt     DateTime @default(now())

  @@index([userId])
}

model SurgeryView {
  id            String   @id @default(cuid())
  name          String
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  config        Json     // { query, columns, viewMode }
  visibility    String   @default("PRIVATE") // PRIVATE | EVERYONE | TEAM | CUSTOM
  teamId        String?
  sharedUserIds String[] @default([])
  createdAt     DateTime @default(now())

  @@index([userId])
}

model TaskView {
  id            String   @id @default(cuid())
  name          String
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  config        Json     // { filter, columns, frozen, viewMode }
  visibility    String   @default("PRIVATE") // PRIVATE | EVERYONE | TEAM | CUSTOM
  teamId        String?
  sharedUserIds String[] @default([])
  createdAt     DateTime @default(now())

  @@index([userId])
}

model ReferralView {
  id            String   @id @default(cuid())
  name          String
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  config        Json     // { query, columns }
  visibility    String   @default("PRIVATE") // PRIVATE | EVERYONE | TEAM | CUSTOM
  teamId        String?
  sharedUserIds String[] @default([])
  createdAt     DateTime @default(now())

  @@index([userId])
}

// Which fields (and their order) appear in an object's "create record" modal.
// objectType is a built-in entity type (REFERRAL, SURGERY, …) or "CO:<key>" for a
// custom object. fields = [{ key, required? }]. No row = show the full catalog.
model CreateFormConfig {
  id         String   @id @default(cuid())
  objectType String   @unique
  fields     Json     @default("[]")
  updatedAt  DateTime @default(now()) @updatedAt
}

// Per-user display order for the saved-view tabs on a list. One row per
// (user, viewType, scopeKey); orderedIds are the view ids in the user's order.
model UserViewOrder {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewType   String   // "SURGERY" | "ACTIVITY" | "PROVIDER" | "CUSTOM_OBJECT"
  scopeKey   String   @default("") // custom-object key for CUSTOM_OBJECT, "" otherwise
  orderedIds String[] @default([])
  updatedAt  DateTime @updatedAt

  @@unique([userId, viewType, scopeKey])
}

model DirectEmail {
  id       String   @id @default(cuid())
  to       String[]
  cc       String[]
  bcc      String[]
  subject  String
  body     String
  sentAt   DateTime @default(now())
  success  Boolean  @default(true)
  error    String?
  // Direction + threading. Outbound is app-sent; inbound is a reply pulled from
  // the mailbox. fromEmail is the sender (app mailbox for outbound, the external
  // replier for inbound). conversationId groups a thread; internetMessageId dedupes.
  direction         String   @default("OUTBOUND") // OUTBOUND | INBOUND
  fromEmail         String?
  mailbox           String?  // the app mailbox this was sent from / received in
  conversationId    String?
  internetMessageId String?  @unique
  graphMessageId    String?  // Graph message id (to reply in-thread)
  sentById String?
  sentBy   User?    @relation(fields: [sentById], references: [id])
  // Files sent with the email that are viewable from the record's timeline:
  // array of { name, url } where url serves the saved RecordAttachment.
  attachments Json  @default("[]")

  @@index([sentAt])
  @@index([conversationId])
  @@index([fromEmail])
}

model ActivityTag {
  activityId String
  tagId      String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([activityId, tagId])
}

model ActivityProvider {
  activityId String
  doctorId   String
  activity   Activity        @relation(fields: [activityId], references: [id], onDelete: Cascade)
  doctor     ReferringDoctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@id([activityId, doctorId])
}

enum IvrAction {
  PLAY_MESSAGE
  FORWARD_CALL
  HANG_UP
}

enum SmsDirection {
  INBOUND
  OUTBOUND
}

model SmsThread {
  id            String       @id @default(cuid())
  phone         String       // E.164 format e.g. +15551234567
  contactName   String?
  referralId    String?
  referral      Referral?    @relation(fields: [referralId], references: [id], onDelete: SetNull)
  lastMessageAt DateTime     @default(now())
  unreadCount   Int          @default(0)
  messages      SmsMessage[]
  createdAt     DateTime     @default(now())

  @@index([phone])
  @@index([lastMessageAt])
}

model SmsMessage {
  id         String        @id @default(cuid())
  threadId   String
  thread     SmsThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  body       String
  direction  SmsDirection
  status     String?       // sent | delivered | failed | received
  twilioSid  String?       @unique
  sentById   String?
  sentBy     User?         @relation(fields: [sentById], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())

  @@index([threadId, createdAt])
}

model CompletedAppointment {
  id                       String    @id @default(cuid())
  patientName              String
  mrn                      String?
  phone                    String?
  email                    String?
  appointmentDate          DateTime?
  referringProvider        String
  referringProviderAddress String?
  referringProviderPhone   String?
  importBatchId            String?
  importedAt               DateTime  @default(now())
  createdById              String?
  createdBy                User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([referringProvider])
  @@index([importedAt])
  @@index([importBatchId])
}

model OrgNameRule {
  id             String   @id @default(cuid())
  contains       String   // case-insensitive substring to match
  normalizedName String   // canonical practice name to resolve to
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([order])
}

// Singleton config for the background poller that re-applies the org name rules
// to existing practices on a schedule (so admins don't click "Re-apply" by hand).
model OrgRulesPoller {
  id              String    @id @default("singleton")
  enabled         Boolean   @default(false)
  intervalMinutes Int       @default(60)
  lastRunAt       DateTime?
  lastMerged      Int       @default(0)
}

// An API key for OUR public API (/api/v1). Only the SHA-256 hash is stored; the
// full token is shown once on creation. `scopes` limits what the key can do
// (e.g. ["referrals:read","referrals:write"]).
model ApiToken {
  id          String    @id @default(cuid())
  name        String
  tokenHash   String    @unique
  prefix      String    // non-secret display prefix, e.g. "gosm_1a2b3c"
  scopes      Json      @default("[]")
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([tokenHash])
}

// A third-party integration's UI-managed credentials + config. The API key is
// stored encrypted at rest (see lib/crypto.ts); the webhook secret gates our
// inbound webhook. One row per provider (e.g. "intakeq").
model Integration {
  id            String   @id @default(cuid())
  provider      String   @unique // "intakeq"
  enabled       Boolean  @default(false)
  apiKeyEnc     String?  // AES-256-GCM ciphertext of the API key
  apiKeyHint    String?  // last few chars, for masked display
  webhookSecret String?  // token that must match the inbound webhook's ?token=
  config        Json     @default("{}") // provider-specific settings
  updatedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Activity log for an integration — one row per outbound API call and inbound
// webhook, powering the Activity tab (calls/day, recent errors, request log).
// Pruned to ~30 days on read.
model IntegrationEvent {
  id         String   @id @default(cuid())
  provider   String   // "intakeq"
  kind       String   // "api" | "webhook"
  endpoint   String?
  method     String?
  status     Int?
  ok         Boolean  @default(true)
  message    String?
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([provider, createdAt])
}

// One row per submitted IntakeQ "Gosm 2026 Full Intake" form, so referral-source
// counts can be aggregated by week (English + Spanish folded into one category).
// intakeId is unique, so a webhook re-delivery or backfill overlap upserts rather
// than double-counts.
model IntakeReferralResponse {
  id                String   @id @default(cuid())
  intakeId          String   @unique
  clientId          String?
  clientName        String?  // patient name from IntakeQ (PHI) — for the submissions view
  dateOfBirth       String?  // patient DOB "yyyy-MM-dd" from IntakeQ (PHI)
  questionnaireId   String?
  questionnaireName String?
  language          String?  // "EN" | "ES" | null
  submittedAt       DateTime
  rawAnswer         String?  // the raw "how were you referred?" answer
  category          String   // mapped category, or "Unmapped" / "Unanswered"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([submittedAt])
  @@index([category])
}

// Maps a merged-away record id to its surviving record, so open URLs/bookmarks
// for the deleted record redirect to the survivor instead of 404ing.
model MergeRedirect {
  entity    String // "PROVIDER" | "PRACTICE" | "LOCATION"
  fromId    String
  toId      String
  createdAt DateTime @default(now())

  @@id([entity, fromId])
}

// A history entry for each org-rules run that merged practices (manual or auto).
model OrgRulesRunLog {
  id          String   @id @default(cuid())
  ranAt       DateTime @default(now())
  trigger     String   // "manual" | "auto"
  mergedCount Int      @default(0)
  merges      Json     // [{ from, to }]

  @@index([ranAt])
}

model IvrConfig {
  id             String      @id @default(cuid())
  isActive       Boolean     @default(false)
  greeting       String      @default("Thank you for calling. Please listen to the following options.")
  noInputMessage String      @default("We did not receive your input. Goodbye.")
  invalidMessage String      @default("That is not a valid option. Please try again.")
  gatherTimeout  Int         @default(5)
  options        IvrOption[]
  updatedAt      DateTime    @updatedAt
  createdAt      DateTime    @default(now())
}

model IvrOption {
  id        String    @id @default(cuid())
  configId  String
  config    IvrConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  digit     String    // "1"–"9", "0"
  label     String
  action    IvrAction
  message   String?   // for PLAY_MESSAGE
  forwardTo String?   // for FORWARD_CALL
  order     Int       @default(0)
}

model SmsAutoResponse {
  id          String   @id @default(cuid())
  isActive    Boolean  @default(true)
  trigger     String   // keyword e.g. "YES", "1", "CANCEL"
  matchType   String   @default("exact") // exact | contains | starts_with
  response    String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Sequences (drip campaigns) ───────────────────────────────────────────────

enum StepChannel {
  SMS
  EMAIL
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum StepRunStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model Sequence {
  id            String               @id @default(cuid())
  name          String
  description   String?
  isActive      Boolean              @default(true)
  trigger       String               @default("ON_STATUS_CHANGE") // ON_STATUS_CHANGE | ON_CREATE | MANUAL
  triggerStatus ReferralStatus?
  filters       Json                 @default("{}")               // { referringPracticeId?, insuranceProvider? }
  steps         SequenceStep[]
  enrollments   SequenceEnrollment[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model SequenceStep {
  id         String            @id @default(cuid())
  sequenceId String
  sequence   Sequence          @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  order      Int
  delayDays  Int               @default(0)
  channel     StepChannel
  subject     String?
  body        String
  fromSender  String            @default("referrals")
  attachments Json              @default("[]")
  runs        SequenceStepRun[]
  createdAt  DateTime          @default(now())

  @@index([sequenceId, order])
}

model SequenceEnrollment {
  id         String           @id @default(cuid())
  sequenceId String
  sequence   Sequence         @relation(fields: [sequenceId], references: [id])
  referralId String
  referral   Referral         @relation(fields: [referralId], references: [id], onDelete: Cascade)
  enrolledAt DateTime         @default(now())
  status     EnrollmentStatus @default(ACTIVE)
  stepRuns   SequenceStepRun[]

  @@unique([sequenceId, referralId])
  @@index([referralId])
}

model SequenceStepRun {
  id           String             @id @default(cuid())
  enrollmentId String
  enrollment   SequenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stepId       String
  step         SequenceStep       @relation(fields: [stepId], references: [id])
  scheduledAt  DateTime
  sentAt       DateTime?
  status       StepRunStatus      @default(PENDING)
  error        String?
  createdAt    DateTime           @default(now())

  @@index([status, scheduledAt])
}

// ── Staff Scheduler ───────────────────────────────────────────────────────────

// Org-wide saved state for the embedded "Operations Planner" scheduling dashboard.
// A single "default" row holds the tool's exported JSON payload (autosaved).
model SchedulingState {
  id          String   @id @default(cuid())
  key         String   @unique @default("default")
  data        Json     @default("{}")
  updatedAt   DateTime @updatedAt
  updatedById String?
}

enum StaffRole {
  XR_TECH
  MA
  FD
}

enum SchedDay {
  MON
  TUE
  WED
  THU
  FRI
}

enum AvailabilityType {
  AVAILABLE
  LAST_RESORT
  UNAVAILABLE
}

model ScheduleLocation {
  id               String                    @id @default(cuid())
  code             String                    @unique
  name             String
  openDays         String[]                  @default([])
  order            Int
  entries          ScheduleEntry[]
  staffAssignments StaffLocationAssignment[]
  requirements     LocationRoleRequirement[]

  @@index([order])
}

model LocationRoleRequirement {
  id         String           @id @default(cuid())
  locationId String
  location   ScheduleLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  role       StaffRole
  countMon   Int              @default(0)
  countTue   Int              @default(0)
  countWed   Int              @default(0)
  countThu   Int              @default(0)
  countFri   Int              @default(0)

  @@unique([locationId, role])
}

model StaffMember {
  id                String                   @id @default(cuid())
  name              String
  primaryRole       StaffRole
  roles             StaffRole[]              @default([])
  isLastResort      Boolean                  @default(false)
  isActive          Boolean                  @default(true)
  availability      StaffAvailability[]
  entries           ScheduleEntry[]
  locationAssignments StaffLocationAssignment[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
}

model StaffLocationAssignment {
  staffId    String
  locationId String
  staff      StaffMember      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  location   ScheduleLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([staffId, locationId])
}

model StaffAvailability {
  id      String           @id @default(cuid())
  staffId String
  staff   StaffMember      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  day     SchedDay
  type    AvailabilityType @default(AVAILABLE)

  @@unique([staffId, day])
}

model WeeklySchedule {
  id          String          @id @default(cuid())
  weekOf      DateTime        @db.Date
  notes       String?
  isPublished Boolean         @default(false)
  entries     ScheduleEntry[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([weekOf])
}

model ScheduleEntry {
  id           String           @id @default(cuid())
  scheduleId   String
  schedule     WeeklySchedule   @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  locationId   String
  location     ScheduleLocation @relation(fields: [locationId], references: [id])
  staffId      String
  staff        StaffMember      @relation(fields: [staffId], references: [id])
  assignedRole StaffRole
  day          SchedDay
  createdAt    DateTime         @default(now())

  @@unique([scheduleId, locationId, staffId, day])
  @@index([scheduleId, day])
}

model OutreachTemplate {
  id        String          @id @default(cuid())
  trigger   OutreachTrigger
  channel   OutreachChannel
  subject   String?         // email subject line (email only)
  body      String
  isActive  Boolean         @default(true)
  updatedAt DateTime        @updatedAt
  createdAt DateTime        @default(now())

  @@unique([trigger, channel])
}

// Reusable marketing templates (SMS / Email) managed under the Marketing section.
model MessageTemplate {
  id             String          @id @default(cuid())
  name           String
  channel        OutreachChannel
  subject        String?         // email subject (email only)
  body           String          // rendered HTML (rich text, or generated from blocks)
  blocks         Json?           // email block builder: ordered blocks; null = rich-text mode
  isActive       Boolean         @default(true)
  createdById    String?
  updatedById    String?
  lastViewedById String?
  lastViewedAt   DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([channel])
}

model SavedReport {
  id          String            @id @default(cuid())
  name        String
  config      Json
  isPinned    Boolean           @default(false)
  createdById String
  createdBy   User              @relation("SavedReportCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  dashboards  DashboardReport[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Dashboard {
  id          String            @id @default(cuid())
  name        String
  createdById String
  createdBy   User              @relation("DashboardCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  reports     DashboardReport[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model DashboardReport {
  dashboardId   String
  savedReportId String
  order         Int          @default(0)
  addedAt       DateTime     @default(now())
  dashboard     Dashboard    @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  savedReport   SavedReport  @relation(fields: [savedReportId], references: [id], onDelete: Cascade)

  @@id([dashboardId, savedReportId])
}

// ─── Surgery ──────────────────────────────────────────────────────────────────

enum SurgeryStatus {
  NEW
  SCHEDULED
  PENDING_CONFIRMATION
  PENDING_CLEARANCE
  CANCELED
  COMPLETED
}

model SurgeryCase {
  id                String         @id @default(cuid())
  mrn               String?
  expires           DateTime?
  creationDate      DateTime?
  status            SurgeryStatus  @default(NEW)
  patientName       String
  orderingProvider  String?
  diagnosis         String?
  medicalClearance   String?
  secondaryClearance String?
  dentalClearance    String?
  ctRequired        String?
  glp1              String?
  dme               String?
  physicalTherapy       String?    // Internal/GOSM | External | NA | Undecided
  physicalTherapyDetail String?    // free text shown when physicalTherapy = External
  referral          String?
  facility          String?
  procedure         String?
  surgeryDate       DateTime?
  language          String?        @default("EN")
  email             String?
  notes             String?
  customProperties  Json           @default("{}") // custom property values
  ownerId           String?
  owner             User?          @relation("SurgeryCaseOwner", fields: [ownerId], references: [id])
  createdById       String?
  createdBy         User?          @relation("SurgeryCaseCreatedBy", fields: [createdById], references: [id])
  updatedById       String?
  updatedBy         User?          @relation("SurgeryCaseUpdatedBy", fields: [updatedById], references: [id])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  callAttempts      SurgeryCallAttempt[]
  documents         SurgeryDocument[]
}

model SurgeryCallAttempt {
  id          String       @id @default(cuid())
  caseId      String
  case        SurgeryCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  calledById  String?
  calledBy    User?        @relation("SurgeryCallAttemptCalledBy", fields: [calledById], references: [id])
  outcome     CallOutcome  @default(NO_ANSWER)
  notes       String?
  createdAt   DateTime     @default(now())

  @@index([caseId])
}

model SurgeryDocument {
  id           String      @id @default(cuid())
  caseId       String
  case         SurgeryCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  fileSize     Int?
  contentType  String?
  uploadedById String?
  uploadedBy   User?       @relation("SurgeryDocumentUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime    @default(now())

  @@index([caseId])
}

model MarketingCategory {
  id        String          @id @default(cuid())
  name      String
  order     Int             @default(0)
  createdAt DateTime        @default(now())
  items     MarketingItem[]
}

model MarketingItem {
  id          String            @id @default(cuid())
  categoryId  String
  category    MarketingCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title       String
  description String?
  fileUrl     String
  fileName    String
  createdAt   DateTime          @default(now())
  orders      MarketingOrder[]

  @@index([categoryId])
}

model MarketingOrder {
  id        String        @id @default(cuid())
  itemId    String
  item      MarketingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name      String
  email     String
  quantity  Int
  address   String
  status    String        @default("PENDING")
  createdAt DateTime      @default(now())

  @@index([itemId])
  @@index([status])
}

model MarketingConfig {
  id          String @id @default("singleton")
  notifyEmail String @default("")
}


// A block-based PDF letter/document template (letterhead + tokenized body).
// `blocks` is an ordered array of typed blocks (see lib/document-blocks.ts);
// tokens inside text blocks resolve per record at generation time.
model DocumentTemplate {
  id          String   @id @default(cuid())
  name        String
  objectType  String   // registry key: REFERRAL | PROVIDER | PRACTICE | LOCATION | SURGERY | CO:<key>
  blocks      Json     @default("[]")
  pageSize    String   @default("LETTER")
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([objectType])
}

// An uploaded image/media asset, reusable across the app (email + document
// builders, etc.). Bytes live in the private Blob store; served publicly (bytes
// only, unguessable id) via /api/media/[id] so emails/PDFs can load them.
model MediaAsset {
  id          String   @id @default(cuid())
  name        String
  blobUrl     String   // private Blob url (fetched server-side with the token)
  contentType String
  size        Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
